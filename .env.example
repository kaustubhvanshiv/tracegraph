# PostgreSQL (Supabase connection pooler)
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=changeme_supabase_db_password

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# JWT
JWT_SECRET_KEY=changeme_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (OpenAI or compatible)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Pipeline
DEFAULT_WINDOW_MINUTES=10
MAX_CONTEXT_EVENTS=50

# Google Stitch MCP (UI design generation)
# Get your key: https://stitch.withgoogle.com -> Profile -> Settings -> API Key
STITCH_API_KEY=your-stitch-api-key-here
